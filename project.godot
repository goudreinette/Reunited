; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Reunited"
run/main_scene="res://test levels/Smup Test Level/Shmup Test Level.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://Sprites Algemeen/icon.png"

[aseprite_importers]

aseprite_executable_path="/Applications/Aseprite.app/Contents/MacOS/aseprite"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"

