[sub_resource type="GDScript" id="GDScript_ffbxl"]
script/source = "extends Area2D

var player_inside : bool = false
@export var next_convo : int = 0
var is_talking : bool = false
@export var convos : = [\"convo_1\",\"convo_2\"]
var player : Player
@export var cutscene_nr: int = 1

#@export var pressx : Sprite2D 

func _ready():
	Dialogic.signal_event.connect(_on_dialogic_signal)
	Dialogic.timeline_ended.connect(_on_timeline_ended)
func _on_dialogic_signal(argument:String):
	pass
	
func _process(delta: float) -> void:
	if player_inside and not is_talking :
		$PressX.visible = true
		if  Input.is_action_just_pressed(\"dialogic_default_action\"):
			is_talking = true
			player.cutscenes.show_cutscene(cutscene_nr)
			Dialogic.start(convos[next_convo])	
			#has_entered = true
	else: $PressX.visible = false	
	
	
func _on_timeline_ended():
	## To check if it is OUR timeline
	if is_talking :
		await get_tree().create_timer(0.3).timeout
		is_talking = false
		if next_convo < convos.size(): 
			next_convo += 1
#func _on_end_of_convo_timer_timeout() -> void:
	#is_talking = false
	#
func _on_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Player\") :
		player_inside = true
		##SHOW STILL CUTSCENE
		player = body
func _on_body_exited(body: Node2D) -> void:
	if body is Player :
		player_inside = false 
	
"

[sub_resource type="CircleShape2D" id="CircleShape2D_3nl0a"]
radius = 44.0114

[sub_resource type="GDScript" id="GDScript_vbt80"]
script/source = "extends Area2D

@export var characters : Array[CharacterBody2D] = []
@export var move_time: float = 3
@export var next_level: PackedScene
@export var dialogue:String = \"einde Prison escape\"
@export var dialogue_2:String = \"einde Prison escape 2\"
var is_talking = false
var player_inside = false
var x_pressed = false

func _ready():
	$\"Press X\".visible = false
	$MoveTimer.wait_time = move_time
	Dialogic.timeline_ended.connect(_on_timeline_ended)
	Dialogic.signal_event.connect(_on_dialogic_signal)

	
func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player\":
		player_inside = true
		if not x_pressed:
			$\"Press X\".visible = true
		else: $\"Press X\".visible = false
		
func _on_body_exited(body: Node2D) -> void:
	$\"Press X\".visible = false
	player_inside = false


func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"dialogic_default_action\") and player_inside and x_pressed == false :
		start_cutscene()
		x_pressed = true
		

func start_cutscene():
	$MoveTimer.start()
	Dialogic.start(dialogue)
	is_talking = true
	#is_talking = true
	
func _on_dialogic_signal(argument:String):
	if argument == \"Band\":
		for i in characters:
			i.move_to(i.next_position.position,move_time)
			#is_talking = false
	
	if argument == \"Next_Level\":
		get_tree().change_scene_to_packed(next_level)
		

func _on_move_timer_timeout() -> void:
	if not is_talking: 
		Dialogic.start(dialogue_2)
		
	
#
func _on_timeline_ended():
	is_talking = false
	#if is_talking:
		#get_tree().change_scene_to_packed(next_level)
	#
"

